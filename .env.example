# Claude API key used by the booker proxy (server/). Without it the show runs on the offline booker.
ANTHROPIC_API_KEY=
# Model that books episodes. Haiku is cheap enough to run forever; try claude-sonnet-5 or claude-opus-5 for richer writing.
BOOKER_MODEL=claude-haiku-4-5
# Model for the few long-term calls: season plans and off-season roster changes.
BOOKER_PLAN_MODEL=claude-sonnet-5
PORT=8787
